# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Supabase project (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Image generation. Leave OPENAI_API_KEY blank to get the illustrative placeholder
# render instead of real (paid) generations.
OPENAI_API_KEY=
# Optional overrides:
# IMAGE_MODEL=gpt-image-1        # default
# RENDER_QUALITY=medium          # low | medium | high (cost vs. detail)
# MAX_RENDERS_PER_DAY=10         # per guest, successful + in-progress renders
# OPENAI_BASE_URL=https://api.openai.com

# Spend controls (counts are of non-failed renders in the last 24 hours):
# MAX_RENDERS_PER_IP_PER_DAY=30      # per network; guest sessions are free to create
# MAX_RENDERS_GLOBAL_PER_DAY=200     # site-wide ceiling on spend
# MAX_REFINEMENTS=6                  # edits to one look before starting again
# MAX_REFERENCE_PHOTOS=4             # venue photos sent per render (1 styled + references)
# RENDER_COST_PENCE=                 # optional: recorded on each render row

# Orders (each one makes work for a stylist):
# MAX_ORDERS_PER_DAY=5               # per guest
# MAX_ORDERS_PER_IP_PER_DAY=20       # per network

# Manual order review and supplier confirmation emails. Resend takes priority
# when configured; Brevo is retained for older setups. Without either key, requests appear
# in the staff dashboard, but email is not sent. Configure only on the server.
# BREVO_API_KEY=
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=Styled <support@styleduk.com>
# NOTIFY_REPLY_TO_EMAIL=support@styleduk.com
# NEXT_PUBLIC_SITE_URL=https://styledukprodprogress.vercel.app

# Scheduled jobs. Set to enable the daily supplier calendar (iCal) auto-sync via
# Vercel Cron (vercel.json). Without it, vendors can still sync on demand in the
# portal. Vercel sends this as a Bearer token on cron requests.
# CRON_SECRET=some-long-random-string

# Booking notification queue: enable only after test-account email verification.
# Requires Brevo/Resend sender configuration; false keeps saved jobs blocked.
ENABLE_BOOKING_EMAILS=false

# Brevo delivery callbacks, configured using a Bearer authorization header.
# Use a private random value of at least 32 characters, matching Brevo's webhook.
# BREVO_WEBHOOK_SECRET=

# Resend delivery callbacks: use the endpoint signing secret (whsec_...),
# distinct from the API key. Verified against raw bytes using Svix headers.
# RESEND_WEBHOOK_SECRET=

# Offline encrypted development database exports (not Vercel settings).
# Use an independent private encryption key and store it separately from archives.
# STYLED_DEV_DATABASE_URL=
# BACKUP_ENCRYPTION_KEY=
# STYLED_LOCAL_RESTORE_URL=postgresql://...@localhost/styled_restore_check
# ALLOW_LOCAL_RESTORE=yes

# Pinterest: server-only, disabled until Pinterest expressly approves storage
# of selected Pins and transfer to the image-generation provider.
PINTEREST_IMPORT_ENABLED=false
# PINTEREST_IMPORT_APPROVAL_REFERENCE=private-written-approval-record
# PINTEREST_APP_ID=
# PINTEREST_APP_SECRET=
# Callback: https://styledukprodprogress.vercel.app/api/pinterest/callback

# Support-only staff notices. Independent of ENABLE_BOOKING_EMAILS. Requires a
# provider and the matching Wedding Planner Dev URL/site pair. Defaults off.
# ENABLE_SUPPORT_EMAILS=false
