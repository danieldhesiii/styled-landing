# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.

# Supabase project (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Server only. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Image generation. Leave OPENAI_API_KEY blank to get the illustrative placeholder
# render instead of real (paid) generations.
OPENAI_API_KEY=
# Optional overrides:
# IMAGE_MODEL=gpt-image-1        # default
# RENDER_QUALITY=medium          # low | medium | high (cost vs. detail)
# MAX_RENDERS_PER_DAY=10         # per guest, successful + in-progress renders
# OPENAI_BASE_URL=https://api.openai.com

# Spend controls (counts are of non-failed renders in the last 24 hours):
# MAX_RENDERS_PER_IP_PER_DAY=30      # per network; guest sessions are free to create
# MAX_RENDERS_GLOBAL_PER_DAY=200     # site-wide ceiling on spend
# MAX_REFINEMENTS=6                  # edits to one look before starting again
# MAX_REFERENCE_PHOTOS=4             # venue photos sent per render (1 styled + references)
# RENDER_COST_PENCE=                 # optional: recorded on each render row
