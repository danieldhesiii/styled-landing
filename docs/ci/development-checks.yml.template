name: Development checks
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
permissions:
  contents: read
concurrency:
  group: development-checks-${{ github.ref }}
  cancel-in-progress: true
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      NEXT_TELEMETRY_DISABLED: '1'
      ENABLE_BOOKING_EMAILS: 'false'
      # Fictional build-only values. CI has no hosted database/provider secrets.
      NEXT_PUBLIC_SUPABASE_URL: https://development-check.invalid
      NEXT_PUBLIC_SUPABASE_ANON_KEY: ci-placeholder-public-key
      SUPABASE_SERVICE_ROLE_KEY: ci-placeholder-server-key
      NEXT_PUBLIC_SITE_URL: http://localhost:3000
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
      - run: npm ci
      - name: TypeScript
        run: npx tsc --noEmit
      - name: Behaviour and isolated database tests
        run: npm test
      - name: Build
        run: npm run build
