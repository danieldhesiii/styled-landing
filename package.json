{
  "name": "shoppable-wedding-visualiser",
  "version": "0.1.0",
  "private": true,
  "description": "POC — turns an AI render of a couple's wedding into a priced, bookable order from real local suppliers.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:catalogue": "node scripts/seed-catalogue.mjs",
    "staff:add": "node scripts/add-staff.mjs add",
    "staff:remove": "node scripts/add-staff.mjs remove",
    "demo:orders": "node scripts/demo-orders.mjs add",
    "demo:orders:remove": "node scripts/demo-orders.mjs remove",
    "dev:fake-render": "node scripts/fake-image-server.mjs",
    "test": "node --test tests/*.test.cjs",
    "check": "npm test && tsc --noEmit && next build",
    "readiness:local": "node scripts/readiness-preflight.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "heic-convert": "^2.1.0",
    "next": "15.5.28",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
